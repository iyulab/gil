<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Gil</RootNamespace>
    <Description>Gil's experimental tree judgment path: a resolver that answers repeated LLM requests from a memory of confirmed answers or a small tree of one-token judgments, generates only what they cannot settle, and promotes recurring answers to habits for review.</Description>
    <PackageTags>$(PackageTags);tree;experimental</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gil\Gil.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gil.Tests" />
  </ItemGroup>
</Project>
