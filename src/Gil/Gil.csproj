<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Gil</RootNamespace>
    <Description>Suggests the judged fields of a record from the records already settled, and says how often a suggestion it trusts is right: values settled together, similar settled records, thresholds chosen by replaying them. No model needed.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gil.Abstractions\Gil.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gil.Tests" />
  </ItemGroup>
</Project>
