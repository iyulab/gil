<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Gil.Llm</RootNamespace>
    <Description>Gil's chat and embedding models over IronHive: OpenAI-compatible endpoints (OpenAI, llama.cpp, vLLM) with first-token log-probabilities, reported usage and shared-server retry rules, or any IronHive generator.</Description>
    <!-- No longer packed: 0.26.0 was its last package. The source stays, frozen with the tree track it serves. -->
    <IsPackable>false</IsPackable>
    <PackageTags>$(PackageTags);ironhive;openai</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gil.Abstractions\Gil.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="IronHive.Providers.OpenAI.Compatible" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gil.Tests" />
  </ItemGroup>
</Project>
