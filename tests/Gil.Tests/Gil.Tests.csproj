<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The tests exercise the experimental surface too; tests/SupportedSurface compiles without these. -->
    <NoWarn>$(NoWarn);GIL0001;GIL0002;GIL0003;GIL0004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gil\Gil.csproj" />
    <ProjectReference Include="..\..\src\Gil.Tree\Gil.Tree.csproj" />
    <ProjectReference Include="..\..\src\Gil.IronHive\Gil.IronHive.csproj" />
    <ProjectReference Include="..\..\src\Gil.Sqlite\Gil.Sqlite.csproj" />
    <ProjectReference Include="..\SupportedSurface\SupportedSurface.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\fixtures\conformance\*.json" Link="conformance\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\conformance\trees\*.yaml" Link="conformance\trees\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\core\*.jsonl" Link="core\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
  </ItemGroup>
</Project>
