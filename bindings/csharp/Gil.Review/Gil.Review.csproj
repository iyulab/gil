<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Gil.Review</RootNamespace>
    <!-- The binding shares its version line with the iyulab-gil-review crate it calls. -->
    <Version>0.1.0</Version>
    <Description>Review statistics for checking automated decisions by hand: seeded stratified samples, the Neyman allocation, weighted population estimates with normal and bootstrap intervals, and agreement between two reviewers. A binding to the Rust crate iyulab-gil-review.</Description>
    <PackageTags>sampling;survey;stratified;bootstrap;agreement;review</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Packed only when the per-runtime native libraries are given (GilReviewNativeRoot, below). -->
    <IsPackable>false</IsPackable>
    <IsPackable Condition="'$(GilReviewNativeRoot)' != ''">true</IsPackable>
  </PropertyGroup>

  <!-- Local builds take the native library cargo built in this repository (`cargo build -p gil-review-ffi`). -->
  <PropertyGroup>
    <GilReviewNativeDirectory Condition="'$(GilReviewNativeDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\..\target\debug\</GilReviewNativeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GilReviewNativeDirectory)libgil_review_native.dylib" Condition="Exists('$(GilReviewNativeDirectory)libgil_review_native.dylib')" Link="libgil_review_native.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(GilReviewNativeDirectory)libgil_review_native.so" Condition="Exists('$(GilReviewNativeDirectory)libgil_review_native.so')" Link="libgil_review_native.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(GilReviewNativeDirectory)gil_review_native.dll" Condition="Exists('$(GilReviewNativeDirectory)gil_review_native.dll')" Link="gil_review_native.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    Packing: GilReviewNativeRoot holds one folder per runtime identifier with that runtime's native library, as the
    release build assembles them — <root>/<rid>/{libgil_review_native.so|libgil_review_native.dylib|gil_review_native.dll}.
    Each lands in runtimes/<rid>/native/, where the .NET host finds it for the running platform; packing fails if one
    is missing.
  -->
  <ItemGroup Condition="'$(GilReviewNativeRoot)' != ''">
    <GilReviewNativeLibrary Include="$(GilReviewNativeRoot)/linux-x64/libgil_review_native.so" Rid="linux-x64" />
    <GilReviewNativeLibrary Include="$(GilReviewNativeRoot)/linux-arm64/libgil_review_native.so" Rid="linux-arm64" />
    <GilReviewNativeLibrary Include="$(GilReviewNativeRoot)/osx-x64/libgil_review_native.dylib" Rid="osx-x64" />
    <GilReviewNativeLibrary Include="$(GilReviewNativeRoot)/osx-arm64/libgil_review_native.dylib" Rid="osx-arm64" />
    <GilReviewNativeLibrary Include="$(GilReviewNativeRoot)/win-x64/gil_review_native.dll" Rid="win-x64" />
    <GilReviewNativeLibrary Include="$(GilReviewNativeRoot)/win-arm64/gil_review_native.dll" Rid="win-arm64" />
    <None Include="@(GilReviewNativeLibrary)" Pack="true" PackagePath="runtimes/%(Rid)/native/" Visible="false" />
  </ItemGroup>
  <Target Name="CheckGilReviewNativeLibraries" BeforeTargets="GenerateNuspec" Condition="'$(GilReviewNativeRoot)' != ''">
    <Error Condition="!Exists('%(GilReviewNativeLibrary.Identity)')" Text="GilReviewNativeRoot lacks the %(GilReviewNativeLibrary.Rid) library: %(GilReviewNativeLibrary.Identity)" />
  </Target>

  <!-- The package's own README, in place of the repository's. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gil.Review.Tests" />
  </ItemGroup>
</Project>
