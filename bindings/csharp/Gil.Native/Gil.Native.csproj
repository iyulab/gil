<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Gil.Native</RootNamespace>
    <!-- The binding shares its version line with the iyulab-gil crate whose decision core it calls. -->
    <Version>0.7.0</Version>
    <Description>The Gil decision core through its C ABI: schemas, settled records, deciders and open records, with the answer asked for while a person types read without JSON. A binding to the Rust crate iyulab-gil.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Not packed: it becomes the inside of the Gil package's native release. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Local builds take the native library cargo built in this repository (`cargo build -p gil-ffi`). -->
  <PropertyGroup>
    <GilNativeDirectory Condition="'$(GilNativeDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\..\target\debug\</GilNativeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GilNativeDirectory)libgil_native.dylib" Condition="Exists('$(GilNativeDirectory)libgil_native.dylib')" Link="libgil_native.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(GilNativeDirectory)libgil_native.so" Condition="Exists('$(GilNativeDirectory)libgil_native.so')" Link="libgil_native.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(GilNativeDirectory)gil_native.dll" Condition="Exists('$(GilNativeDirectory)gil_native.dll')" Link="gil_native.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gil.Native.Tests" />
  </ItemGroup>
</Project>
